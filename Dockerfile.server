FROM ocaml/opam:debian-13-ocaml-5.4 AS build

WORKDIR /home/opam/
RUN sudo apt-get install libsqlite3-dev libcurl4-gnutls-dev libjemalloc-dev -y

COPY dune-project Makefile *.opam .gitignore ./
COPY ./vendor/ ./vendor/
RUN opam install . ./vendor/calculon/calculon.opam ./vendor/calculon/calculon-web.opam ./vendor/irky/irky.opam ./vendor/irky/irky-eio.opam --deps-only -y

COPY src/ ./src/
RUN opam exec -- dune build @install

FROM debian:trixie-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-0 libssl3t64 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /home/opam/_build/default/src/coucoubot.exe coucoubot
ENTRYPOINT ./coucoubot
